# Copia este archivo a .env y rellena los valores.
# .env NUNCA se versiona (§K.7). Aquí no hay secretos reales.

# --- Núcleo --------------------------------------------------------------- #
DJANGO_SETTINGS_MODULE=config.settings.development
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-generated-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de datos -------------------------------------------------------- #
# Sin definir: SQLite en db.sqlite3 (desarrollo).
# PostgreSQL: postgres://usuario:contrasena@host:5432/nombre_bd
DATABASE_URL=

# --- Correo (producción) -------------------------------------------------- #
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
ADMIN_EMAILS=

# --- Seguridad (producción) ----------------------------------------------- #
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Actívalo SOLO si hay un proxy inverso de confianza delante.
BEHIND_TRUSTED_PROXY=False

# --- Almacenamiento ------------------------------------------------------- #
# Debe quedar FUERA del árbol servido por el servidor web (§K.4).
MEDIA_ROOT=

# --- Relación laboral ----------------------------------------------------- #
# Salario mínimo mensual vigente (GTQ). Vacío: no se comprueba (RN-22).
# Actualízalo cuando cambie el acuerdo gubernativo.
MINIMUM_MONTHLY_SALARY=
